# Hetzner Servers

Host planet-express
     HostName planet-express.in
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22
     ForwardAgent true

Host bessie
     HostName bessie.planet-express.in
     IdentityFile ~/.ssh/id_ed25519
     User root
     Port 22

Host freebsd-build-pe
     ProxyJump planet-express
     HostName 172.16.0.6
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22

Host freebsd-current-pe
     ProxyJump planet-express
     HostName 172.16.0.7
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22

Host netbsd-build-pe
     ProxyJump planet-express
     HostName 172.16.0.5
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22

Host netbsd-current-pe
     ProxyJump planet-express
     HostName 172.16.0.9
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22

Host ubuntu-test-pe
     ProxyJump planet-express
     HostName 172.16.0.2
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22

Host planet-express-x # planet-express with X forwarding
     HostName planet-express.in
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22
     ForwardX11 yes
     ForwardX11Trusted yes

Host netbsd-build-x # netbsd-build with X forwarding
     HostName 172.16.0.5
     IdentityFile ~/.ssh/id_ed25519
     User fox
     Port 22
     ProxyJump planet-express-x
     ForwardX11 yes
     ForwardX11Trusted yes
     SetEnv TERM=xterm-256color

# NetBSD Stuff

Host wip.pkgsrc.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa

Host cvs.netbsd.org
     HostName cvs.netbsd.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa_netbsd
     User fox
     ForwardAgent true

Host ftp.NetBSD.org # For pkgsrc upload-distfiles
     HostName ftp.netbsd.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa_netbsd
     User fox

Host netbsd-mail # mail.netbsd.org (mail server)
     HostName homeworld.netbsd.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa_netbsd
     User fox

Host netbsd-ftp # {ftp,sup}.NetBSD.org (ftp/sup/rsync server)
     HostName morden.netbsd.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa_netbsd
     User fox

Host netbsd-www # {www,gnats,wiki}.NetBSD.org (http/gnats server)
     HostName mollari.netbsd.org
     PubKeyAuthentication yes
     IdentityFile ~/.ssh/id_rsa_netbsd
     User fox

